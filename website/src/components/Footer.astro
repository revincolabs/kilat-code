---
import { VERSION } from "../site";
import { localePath, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href={localePath(lang, "/")} aria-label={t.home}>
          <img src="/icon-64.png" alt="" width="28" height="28" loading="lazy" />
          <span>Kilat Code</span>
        </a>
        <p set:html={t.footTagline} />
      </div>
      {
        t.footCols.map((c) => (
          <nav class="foot-col" aria-label={c.title}>
            <h2>{c.title}</h2>
            <ul>
              {c.links.map(([label, href]) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="foot-bottom">
      <p>{t.disclaimer}</p>
      <span>© {year} Revinco Labs · v{VERSION}</span>
    </div>
  </div>
</footer>
