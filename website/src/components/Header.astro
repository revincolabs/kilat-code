---
import { REPO_URL } from "../site";

interface Props {
  current: "home" | "docs";
}
const { current } = Astro.props;
const links = [
  { href: "/#fitur", label: "Fitur" },
  { href: "/#limit", label: "Saat kena limit" },
  { href: "/docs", label: "Dokumentasi", page: "docs" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Kilat Code, beranda">
      <img src="/icon.png" alt="" width="30" height="30" />
      <span>Kilat Code</span>
    </a>
    <nav class="nav-links" id="nav-links" aria-label="Navigasi utama">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.page === current ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="nav-gh-m" href={REPO_URL}>GitHub</a>
    </nav>
    <div class="nav-end">
      <a class="nav-gh" href={REPO_URL}>GitHub</a>
      <a class="btn btn-ink" href="/#download">Download <span class="arr" aria-hidden="true">→</span></a>
      <button class="nav-toggle" aria-label="Buka menu" aria-expanded="false" aria-controls="nav-links">
        Menu
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>
