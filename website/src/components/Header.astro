---
import Icon from "./Icon.astro";
import { REPO_URL } from "../site";

interface Props {
  current: "home" | "docs";
}
const { current } = Astro.props;
const links = [
  { href: "/#fitur", label: "Fitur" },
  { href: "/#limit", label: "Saat kena limit" },
  { href: "/docs", label: "Dokumentasi", page: "docs" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Kilat Code, beranda">
      <img src="/icon.png" alt="" width="28" height="28" />
      <b>Kilat Code</b>
      <span class="by">by revincolabs</span>
    </a>
    <nav class="nav-links" id="nav-links" aria-label="Navigasi utama">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.page === current ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <a class="nav-gh" href={REPO_URL} aria-label="Kode sumber di GitHub"><Icon name="github" /></a>
    <a class="btn small primary" href="/#download">Download</a>
    <button class="nav-toggle" aria-label="Buka menu" aria-expanded="false" aria-controls="nav-links">
      <Icon name="menu" />
    </button>
  </div>
</header>
