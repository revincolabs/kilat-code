---
import GithubMark from "./GithubMark.astro";
import { REPO_URL } from "../site";

interface Props {
  current: "home" | "docs";
}
const { current } = Astro.props;
const links = [
  { href: "/#fitur", label: "Fitur" },
  { href: "/#limit", label: "Saat kena limit" },
  { href: "/docs", label: "Dokumentasi", page: "docs" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Kilat Code, beranda">
      <img src="/icon.png" alt="" width="28" height="28" />
      <span>Kilat Code</span>
    </a>
    <nav class="nav-links" id="nav-links" aria-label="Navigasi utama">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.page === current ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="nav-gh-m" href="/#download">Download</a>
    </nav>
    <div class="nav-end">
      <a class="icon-btn" href={REPO_URL} aria-label="Kode sumber di GitHub" title="GitHub">
        <GithubMark size={22} />
      </a>
      <a class="btn btn-yellow btn-sm" href="/#download">Download</a>
      <button class="icon-btn nav-toggle" aria-label="Buka menu" aria-expanded="false" aria-controls="nav-links">
        <svg class="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
        <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav-toggle .i-close,
  :global(.site-header.open) .nav-toggle .i-menu {
    display: none;
  }
  :global(.site-header.open) .nav-toggle .i-close {
    display: block;
  }
</style>
