---
// Every platform's downloads side by side (home page and docs).
import { PLATFORMS, RELEASES_URL, VERSION } from "../site";

const icons: Record<string, string> = {
  windows: '<path d="M3 5.5l7.5-1v7H3zM12 4.3L21 3v8.5h-9zM3 12.5h7.5v7L3 18.5zM12 12.5h9V21l-9-1.3z"/>',
  mac: '<path d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.8-.8-3-.8c-1.5 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7 2-1.1 2.8-2.3c.9-1.3 1.2-2.5 1.3-2.6-.1 0-2.5-.9-2.5-3.8zM14.1 5.8c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.7-1.3z"/>',
  linux:
    '<path d="M12 3c-2 0-3.2 1.7-3.2 4 0 1.4.4 2.3.2 3.2-.3 1.3-2.5 3.4-2.9 5.6-.3 1.6.4 2.8 1.6 3.2M12 3c2 0 3.2 1.7 3.2 4 0 1.4-.4 2.3-.2 3.2.3 1.3 2.5 3.4 2.9 5.6.3 1.6-.4 2.8-1.6 3.2M8.2 19.8c1 .7 2.4 1.2 3.8 1.2s2.8-.5 3.8-1.2M10.5 7.5h.01M13.5 7.5h.01"/>',
};
---

<div class="dl-grid">
  {
    PLATFORMS.map((p) => (
      <div class="dl-card" data-os={p.id}>
        <div class="dl-head">
          <span class="dl-ic">
            <svg
              viewBox="0 0 24 24"
              fill={p.id === "linux" ? "none" : "currentColor"}
              stroke={p.id === "linux" ? "currentColor" : "none"}
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[p.id]}
            />
          </span>
          <b>{p.name}</b>
        </div>
        <div class="dl-req">{p.requirement}</div>
        <div class="dl-files">
          {p.files.map((f, i) => (
            <a class:list={["btn", "small", { primary: i === 0 }]} href={f.url}>
              {f.label}
              {f.size && <span class="size">{f.size}</span>}
            </a>
          ))}
        </div>
        <p class="dl-note">{p.note}</p>
      </div>
    ))
  }
</div>
<p class="dl-foot">
  Versi {VERSION}. <a href={RELEASES_URL}>Semua file dan catatan rilis ada di GitHub</a>.
</p>

<script>
  // Put the visitor's OS first and mark it.
  const p = `${navigator.platform ?? ""} ${navigator.userAgent}`.toLowerCase();
  const os = /iphone|ipad|android/.test(p) ? null : /mac/.test(p) ? "mac" : /win/.test(p) ? "windows" : /linux|x11/.test(p) ? "linux" : null;
  if (os) {
    document.querySelectorAll<HTMLElement>(`.dl-card[data-os="${os}"]`).forEach((card) => {
      card.classList.add("mine");
      card.parentElement?.prepend(card);
    });
  }
</script>
