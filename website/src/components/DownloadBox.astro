---
// Every platform's downloads side by side (home page and docs).
import { PLATFORMS } from "../site";
import { mb, ui, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}
const { lang = "id" } = Astro.props;
const t = ui[lang];
---

<div class="dl-grid">
  {
    PLATFORMS.map((p) => (
      <div class="dl-card" data-os={p.id}>
        <h3>
          {p.name}
          <span class="mine-tag">{t.yourSystem}</span>
        </h3>
        <p class="dl-req">{p.requirement}</p>
        <div class="dl-files">
          {p.files.map((f) => (
            <a class="btn btn-line" href={f.url}>
              <span>{f.label}</span>
              <span class="size">{mb(lang, f.mb)}</span>
            </a>
          ))}
        </div>
        <p class="dl-note">{p.note[lang]}</p>
      </div>
    ))
  }
</div>
<p class="dl-foot" set:html={t.dlFoot} />

<script>
  // Put the visitor's OS first and mark it.
  const p = `${navigator.platform ?? ""} ${navigator.userAgent}`.toLowerCase();
  const os = /iphone|ipad|android/.test(p) ? null : /mac/.test(p) ? "mac" : /win/.test(p) ? "windows" : /linux|x11/.test(p) ? "linux" : null;
  if (os) {
    document.querySelectorAll<HTMLElement>(`.dl-card[data-os="${os}"]`).forEach((card) => {
      card.classList.add("mine");
      card.parentElement?.prepend(card);
    });
  }
</script>
