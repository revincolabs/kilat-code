---
// A content block: bolt label, large heading and optional lead on top, then
// whatever the page puts below (usually a .split of text and a visual).
interface Props {
  id?: string;
  label: string;
  title: string;
  lead?: string;
}
const { id, label, title, lead } = Astro.props;
---

<section class="block" id={id}>
  <div class="wrap">
    <header class="block-head">
      <p class="label">{label}</p>
      <h2>{title}</h2>
      {lead && <p class="block-lead">{lead}</p>}
    </header>
    <slot />
  </div>
</section>
