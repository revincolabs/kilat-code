---
import { DOWNLOAD_URL } from "../site";

interface Props {
  label?: string;
  small?: boolean;
}
const { label = "Download untuk Windows", small = false } = Astro.props;
---

<a class:list={["btn", "primary", { small }]} href={DOWNLOAD_URL} download>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3v12m0 0l-5-5m5 5l5-5M4 19h16"></path>
  </svg>
  {label}
</a>
