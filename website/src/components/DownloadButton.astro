---
import { PLATFORMS } from "../site";

interface Props {
  /** "yellow" on light backgrounds, "dark" on the yellow panel */
  tone?: "yellow" | "dark";
}
const { tone = "yellow" } = Astro.props;
const fallback = PLATFORMS[0];
// The browser swaps in the visitor's OS (script below); without JS it stays Windows.
const links = Object.fromEntries(PLATFORMS.map((p) => [p.id, { url: p.files[0].url, name: p.name }]));
---

<a class:list={["btn", tone === "dark" ? "btn-dark" : "btn-yellow"]} href={fallback.files[0].url} data-os-download={JSON.stringify(links)}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14"></path>
  </svg>
  <span class="os-label">Download untuk {fallback.name}</span>
</a>

<script>
  function visitorOs(): "windows" | "mac" | "linux" | null {
    const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
    const p = `${nav.userAgentData?.platform ?? ""} ${navigator.platform ?? ""} ${navigator.userAgent}`.toLowerCase();
    if (/iphone|ipad|android/.test(p)) return null; // phones: keep the default, the download section lists all
    if (/mac/.test(p)) return "mac";
    if (/win/.test(p)) return "windows";
    if (/linux|x11|cros/.test(p)) return "linux";
    return null;
  }
  const os = visitorOs();
  if (os) {
    document.querySelectorAll<HTMLAnchorElement>("a[data-os-download]").forEach((a) => {
      const pick = JSON.parse(a.dataset.osDownload ?? "{}")[os];
      if (!pick) return;
      a.href = pick.url;
      const text = a.querySelector(".os-label");
      if (text) text.textContent = `Download untuk ${pick.name}`;
    });
  }
</script>
