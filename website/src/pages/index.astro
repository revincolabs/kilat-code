---
import Base from "../layouts/Base.astro";
import AppMockup from "../components/AppMockup.astro";
import DownloadButton from "../components/DownloadButton.astro";
import DownloadBox from "../components/DownloadBox.astro";
import Icon from "../components/Icon.astro";
import { REPO_URL, VERSION } from "../site";

const trust = [
  "Terminal Claude Code & Codex asli",
  "Update otomatis yang ditandatangani",
  "Token & data tetap di komputermu",
  "Windows · macOS · Linux",
];

// Problem statement → how Kilat answers it.
const problems = [
  {
    title: "Kuota habis di tengah pekerjaan",
    text: "Agent berhenti persis saat sedang memperbaiki test, dan kamu harus menunggu berjam-jam.",
    fix: "Tunggu otomatis sampai reset, atau lanjut dengan akun lain dalam satu klik.",
  },
  {
    title: "Ganti akun berarti login ulang",
    text: "Akun kantor, akun pribadi, Claude, ChatGPT: logout, login, dan konteks percakapan hilang.",
    fix: "Login sekali per akun. Pilih dari dropdown, sesi dan konteks ikut pindah.",
  },
  {
    title: "Terminal agent berserakan",
    text: "Lima jendela terminal, tidak tahu mana yang selesai, mana yang menunggu izin.",
    fix: "Semua agent di satu jendela, dengan status dan notifikasi.",
  },
];

const more = [
  { icon: "git", title: "Git & GitHub bawaan", text: "Editor, diff, commit, push, branch, dan pull request. Pesan commit bisa ditulis agent." },
  { icon: "users", title: "GitHub multi-akun", text: "Akun GitHub dipilih per project dan langsung berlaku, termasuk di terminal yang sedang jalan." },
  { icon: "chart", title: "Pemakaian kuota", text: "Persentase limit 5 jam dan 7 hari beserta jam resetnya, di statusline dan daftar akun." },
  { icon: "bell", title: "Notifikasi", text: "Notifikasi sistem dan suara saat agent selesai, butuh izin, atau kena limit." },
  { icon: "puzzle", title: "Skill, plugin & MCP", text: "Semua yang sudah kamu pasang di Claude Code dan Codex tetap jalan di setiap akun." },
  { icon: "zap", title: "Ringan & selalu baru", text: "Tauri + Rust, bukan Electron. Installer Windows sekitar 3 MB, update otomatis." },
];

const compare = [
  ["Agent Claude Code / Codex yang asli", true, true],
  ["Banyak akun tanpa login ulang", false, true],
  ["Pilihan saat kena limit + lanjut otomatis", false, true],
  ["Pindah Claude ↔ ChatGPT dengan konteks", false, true],
  ["Status semua agent + notifikasi", false, true],
  ["Editor, diff, commit, dan PR di satu tempat", false, true],
] as const;

const steps = [
  ["Unduh & pasang", "Installer untuk Windows, macOS, atau Linux. Di Windows terpasang per pengguna, tanpa hak admin."],
  ["Tambah akun", "Buka <b>Akun &amp; Pengaturan</b>, login Claude, ChatGPT, dan GitHub. Masing-masing satu klik di browser."],
  ["Buka folder, buat thread", "Pilih folder project, klik <b>+ Thread baru</b>. Terminal agent langsung siap dipakai."],
];

const faq = [
  ["Apakah Kilat Code gratis?", "Ya. Kamu tetap butuh langganan atau API key Claude dan/atau ChatGPT sendiri. Kilat hanya menjalankan CLI resminya dengan akunmu."],
  [
    "Apakah kuota saya bisa digabung dari beberapa akun?",
    "Kilat tidak menggabungkan kuota. Ia hanya memudahkan kamu memilih akun mana yang menjalankan agent, dan melanjutkan pekerjaan saat satu akun kena limit. Pastikan cara kamu memakai akun sesuai ketentuan layanan masing-masing penyedia.",
  ],
  [
    "Skill, plugin, dan MCP server saya tetap jalan?",
    "Ya. Claude Code memakai folder <code>~/.claude</code> milikmu di semua akun, jadi plugin, skill, MCP, hook, dan <code>CLAUDE.md</code> ikut. Untuk Codex, skill, aturan, prompt, plugin, dan <code>config.toml</code> dibagikan ke setiap akun ChatGPT.",
  ],
  [
    "Di mana token dan data saya disimpan?",
    "Semuanya di komputermu. Token disimpan di penyimpan rahasia sistem (Credential Manager di Windows, Keychain di macOS, Secret Service di Linux). Kilat tidak punya server sendiri.",
  ],
  [
    "Muncul peringatan keamanan saat memasang. Aman?",
    "Installer Kilat belum ditandatangani secara digital. Di Windows, klik <b>More info</b> lalu <b>Run anyway</b> pada SmartScreen. Di macOS, klik kanan aplikasi lalu <b>Open</b>. Kodenya bisa kamu periksa di GitHub.",
  ],
  [
    "Bisa dipakai di macOS atau Linux?",
    "Bisa: macOS 11+ (Apple Silicon &amp; Intel) dan Linux x86_64 (AppImage atau .deb). Versi Windows yang paling banyak diuji; macOS dan Linux masih tahap awal, jadi laporan masalah sangat membantu.",
  ],
  [
    "Apa bedanya dengan menjalankan CLI di terminal biasa?",
    "Agent-nya sama persis. Kilat menambahkan banyak akun tanpa login ulang, pilihan saat kena limit, perpindahan Claude ↔ ChatGPT dengan konteks, status semua agent di satu tempat, notifikasi, editor, diff, dan GitHub multi-akun.",
  ],
];
---

<Base current="home">
  <main id="isi">
    <!-- ================================================================ hero -->
    <section class="hero">
      <div class="wrap">
        <span class="eyebrow"><b>v{VERSION}</b><span class="dot ok"></span> Gratis untuk Windows, macOS &amp; Linux</span>
        <h1><span class="l">Banyak agent coding.</span> <span class="l">Banyak akun.</span> <em class="l">Satu jendela kilat.</em></h1>
        <p class="lead">
          Kilat Code menjalankan terminal Claude Code dan Codex yang asli, berdampingan. Saat satu akun kena limit, tunggu sampai reset atau lanjutkan
          dengan akun Claude atau ChatGPT lain. Konteksnya tetap utuh.
        </p>
        <div class="cta">
          <DownloadButton />
          <a class="btn" href={REPO_URL}><Icon name="github" /> Lihat di GitHub</a>
        </div>
        <ul class="trust">
          {
            trust.map((t) => (
              <li>
                <Icon name="check" />
                {t}
              </li>
            ))
          }
        </ul>
        <AppMockup />
      </div>
    </section>

    <!-- ===================================================== problem → solution -->
    <section class="section-line">
      <div class="wrap">
        <p class="kicker">masalahnya</p>
        <h2>Kerja dengan banyak agent itu melelahkan</h2>
        <p class="sub">Tiga hal yang membuat kita berhenti di tengah jalan, dan bagaimana Kilat menyelesaikannya.</p>
        <div class="problems">
          {
            problems.map((p) => (
              <article class="problem">
                <div class="ic">
                  <Icon name="alert" />
                </div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
                <div class="fix">
                  <Icon name="check" />
                  <span>{p.fix}</span>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ========================================================= feature rows -->
    <section id="fitur" class="band">
      <div class="wrap">
        <div class="center">
          <p class="kicker">fitur</p>
          <h2>Dibuat untuk orang yang menjalankan banyak agent</h2>
          <p class="sub">Bukan chat tiruan. Tiap thread adalah terminal agent yang asli, ditambah hal-hal yang tidak dimiliki terminal biasa.</p>
        </div>

        <div class="rows">
          <!-- limit -->
          <div class="row" id="limit">
            <div class="copy">
              <p class="kicker">saat kena limit</p>
              <h3>Kuota habis? Pekerjaan tetap jalan</h3>
              <p>Kilat menangkap limit dari hook Claude Code dan file sesi Codex, lalu langsung menawarkan jalan keluar di atas terminal agent itu.</p>
              <ul class="checks">
                <li>
                  <Icon name="check" /><span><b>Tunggu, lalu lanjut sendiri.</b> Jam reset dibaca dari CLI; saat waktunya tiba agent dijalankan ulang dan diminta melanjutkan (selama Kilat terbuka).</span>
                </li>
                <li><Icon name="check" /><span><b>Akun Claude lain.</b> Sesi yang sama dilanjutkan, lengkap dengan seluruh percakapannya.</span></li>
                <li><Icon name="check" /><span><b>Akun ChatGPT.</b> Riwayat percakapan diteruskan ke Codex sebagai konteks.</span></li>
              </ul>
            </div>
            <div class="panel" aria-hidden="true">
              <div class="limit">
                <h4>Akun Claude "Kerja" kena limit</h4>
                <div class="m">You've hit your session limit · resets 3pm</div>
                <div class="w">Tunggu sampai 15.00, lalu lanjut otomatis</div>
                <div class="k">Pindah ke akun Claude lain <span>· sesi sama</span></div>
                <div class="a"><b>Pribadi</b><span>PRO · 5 jam 12%</span></div>
                <div class="k">Pindah ke akun ChatGPT <span>· riwayat diteruskan</span></div>
                <div class="a"><b>Tim</b><span>PLUS · 18%</span></div>
              </div>
            </div>
          </div>

          <!-- real terminal -->
          <div class="row flip">
            <div class="copy">
              <p class="kicker">terminal asli</p>
              <h3>Claude Code dan Codex apa adanya</h3>
              <p>Tidak ada antarmuka chat buatan. Slash command, <code>/model</code>, izin, mode bash: semua jalan persis seperti di terminalmu.</p>
              <ul class="checks">
                <li><Icon name="check" /><span><b>Agent tetap jalan di belakang</b> saat kamu pindah thread.</span></li>
                <li><Icon name="check" /><span><b>Statusline menunjukkan akun</b> yang sedang dipakai beserta sisa kuotanya.</span></li>
                <li><Icon name="check" /><span><b>Model & mode izin</b> bisa diganti dari bar di atas terminal.</span></li>
              </ul>
            </div>
            <div class="panel" aria-hidden="true">
              <div class="term">
                <div><span class="c">▐▛███▜▌</span>  Claude Code</div>
                <div class="g">        Opus · Claude Max · ~/toko-online</div>
                <div class="p">❯ tambahkan validasi email di form daftar</div>
                <div>● Membaca <span class="y">src/auth/register.ts</span></div>
                <div class="g">  Edit src/auth/register.ts (+18 -2)</div>
                <div>● Bash(npm test -- register)</div>
                <div class="okc">  ⎿ 12 passed</div>
                <div>● Validasi email selesai, semua test lulus.</div>
                <div class="g">────────────────────────────────────</div>
                <div class="g">  <span class="y">⚡ Kilat</span> · Kerja · MAX · 5 jam 41% · 7 hari 53%</div>
              </div>
            </div>
          </div>

          <!-- switching -->
          <div class="row">
            <div class="copy">
              <p class="kicker">konteks tetap utuh</p>
              <h3>Ganti akun atau provider tanpa mulai dari nol</h3>
              <p>Kilat mencatat akun dan sesi asli di setiap bagian percakapan, jadi tiap jenis perpindahan memakai cara yang paling setia.</p>
              <ul class="checks">
                <li><Icon name="check" /><span><b>Claude → Claude:</b> sesi yang sama di-<code>--resume</code>, hanya tokennya yang berganti.</span></li>
                <li><Icon name="check" /><span><b>ChatGPT → ChatGPT:</b> folder sesi dibagi, <code>codex resume</code> melanjutkan thread.</span></li>
                <li><Icon name="check" /><span><b>Claude ↔ ChatGPT:</b> bagian yang belum dilihat agent baru diteruskan sebagai riwayat.</span></li>
              </ul>
            </div>
            <div class="panel" aria-hidden="true">
              <div class="flowline">
                <div class="seg">
                  <span class="who claude">Claude</span>
                  <span><b>Kerja</b><small>refactor modul pembayaran</small></span>
                  <span class="how warn">kena limit</span>
                </div>
                <div class="arrow"><Icon name="arrowDown" /> resume sesi yang sama</div>
                <div class="seg">
                  <span class="who claude">Claude</span>
                  <span><b>Pribadi</b><small>melanjutkan perbaikan test</small></span>
                  <span class="how">lanjut</span>
                </div>
                <div class="arrow"><Icon name="arrowDown" /> riwayat diteruskan</div>
                <div class="seg">
                  <span class="who codex">ChatGPT</span>
                  <span><b>Tim</b><small>review dan rapikan kode</small></span>
                  <span class="how">konteks utuh</span>
                </div>
              </div>
            </div>
          </div>

          <!-- parallel -->
          <div class="row flip">
            <div class="copy">
              <p class="kicker">paralel</p>
              <h3>Banyak agent, satu jendela</h3>
              <p>Jalankan beberapa thread sekaligus di project yang sama atau berbeda. Kilat memberi tahu saat ada yang selesai atau butuh kamu.</p>
              <ul class="checks">
                <li><Icon name="check" /><span><b>Worktree git terpisah</b> per thread, supaya agent tidak saling menimpa file.</span></li>
                <li><Icon name="check" /><span><b>Status sekilas:</b> bekerja, siap, butuh izin, atau kena limit.</span></li>
                <li><Icon name="check" /><span><b>Notifikasi</b> saat jendela Kilat sedang tidak aktif.</span></li>
              </ul>
            </div>
            <div class="panel" aria-hidden="true">
              <div class="agents">
                <div class="agent"><i class="d run"></i><span>Halaman checkout baru</span><span class="tag" style="color: var(--codex)">ChatGPT</span><span class="state">bekerja</span></div>
                <div class="agent"><i class="d run"></i><span>Migrasi database</span><span class="tag" style="color: var(--claude)">Claude</span><span class="state">bekerja</span></div>
                <div class="agent"><i class="d warn"></i><span>Refactor pembayaran</span><span class="tag" style="color: var(--claude)">Claude</span><span class="state">butuh izin</span></div>
                <div class="agent"><i class="d ok"></i><span>Tulis dokumentasi API</span><span class="tag" style="color: var(--codex)">ChatGPT</span><span class="state">siap</span></div>
              </div>
              <div class="toast"><Icon name="bell" /><span><b>Perbaiki bug login:</b> agent selesai</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ more grid -->
    <section>
      <div class="wrap">
        <p class="kicker">dan juga</p>
        <h2>Semua yang dibutuhkan di sekitar agent</h2>
        <p class="sub">Supaya kamu tidak perlu bolak-balik ke aplikasi lain.</p>
        <div class="grid">
          {
            more.map((f) => (
              <article class="card">
                <div class="ic">
                  <Icon name={f.icon as any} />
                </div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================ compare -->
    <section id="bandingkan" class="section-line">
      <div class="wrap">
        <p class="kicker">bandingkan</p>
        <h2>Terminal biasa vs Kilat Code</h2>
        <p class="sub">Agent yang sama, ditambah hal-hal yang biasanya harus kamu urus sendiri.</p>
        <div class="table-wrap">
          <table class="compare">
            <thead>
              <tr>
                <th scope="col">Kemampuan</th>
                <th scope="col">Terminal biasa</th>
                <th scope="col" class="us">Kilat Code</th>
              </tr>
            </thead>
            <tbody>
              {
                compare.map(([what, plain, kilat]) => (
                  <tr>
                    <td>{what}</td>
                    <td>
                      <span class={plain ? "yes" : "no"}>
                        <Icon name={plain ? "check" : "minus"} label={plain ? "ada" : "tidak ada"} />
                      </span>
                    </td>
                    <td>
                      <span class={kilat ? "yes" : "no"}>
                        <Icon name={kilat ? "check" : "minus"} label={kilat ? "ada" : "tidak ada"} />
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============================================================== start -->
    <section id="mulai" class="section-line">
      <div class="wrap">
        <p class="kicker">mulai</p>
        <h2>Pasang sekali, langsung kerja</h2>
        <p class="sub">
          Yang kamu perlukan: Git dan Claude Code CLI atau Codex CLI. <a href="/docs#persyaratan">Lihat persyaratan lengkap</a>.
        </p>
        <div class="install">
          {
            steps.map(([t, p]) => (
              <article class="card">
                <h3>{t}</h3>
                <p set:html={p} />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- =========================================================== download -->
    <section id="download" class="band">
      <div class="wrap">
        <div class="center">
          <p class="kicker">download</p>
          <h2>Pilih sistem operasimu</h2>
          <p class="sub">Gratis. Aplikasi memeriksa update sendiri, jadi cukup unduh sekali.</p>
        </div>
        <DownloadBox />
      </div>
    </section>

    <!-- ================================================================ faq -->
    <section id="faq">
      <div class="wrap">
        <div class="center">
          <p class="kicker">faq</p>
          <h2>Pertanyaan yang sering muncul</h2>
        </div>
        <div class="faq">
          {
            faq.map(([q, a]) => (
              <details>
                <summary>{q}</summary>
                <p set:html={a} />
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================== final -->
    <section class="final">
      <div class="wrap">
        <img src="/icon.png" alt="" width="76" height="76" loading="lazy" />
        <h2>Siap kerja lebih kilat?</h2>
        <p class="sub center">Unduh Kilat Code dan jalankan agent pertamamu dalam beberapa menit.</p>
        <div class="cta">
          <DownloadButton label={`Download v${VERSION}`} />
          <a class="btn" href="/docs#mulai-cepat"><Icon name="book" /> Panduan mulai cepat</a>
        </div>
        <div class="maker">Dibuat dan dirawat oleh <b>revincolabs</b></div>
      </div>
    </section>
  </main>
</Base>
