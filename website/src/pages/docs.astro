---
import Base from "../layouts/Base.astro";
import { Content, getHeadings } from "../docs/docs.mdx";

// Table of contents from the document's own headings, in groups that start
// at these sections.
const groupStarts: Record<string, string> = {
  "mulai-cepat": "Mulai",
  "project-dan-thread": "Memakai",
  "editor-diff-dan-commit": "Alat lain",
  pengaturan: "Referensi",
};
const sections = getHeadings().filter((h) => h.depth === 2);
---

<Base
  title="Dokumentasi"
  current="docs"
  description="Panduan lengkap Kilat Code: instalasi, akun Claude/ChatGPT/GitHub, thread terminal agent, ganti akun, saat kena limit, Git, pengaturan, dan pemecahan masalah."
>
  <div class="wrap docs">
    <aside class="toc" aria-label="Daftar isi">
      {
        sections.map((h) => (
          <>
            {groupStarts[h.slug] && <h5>{groupStarts[h.slug]}</h5>}
            <a href={`#${h.slug}`}>{h.text}</a>
          </>
        ))
      }
    </aside>
    <main class="doc" id="isi">
      <p class="kicker">dokumentasi</p>
      <h1>Panduan Kilat Code</h1>
      <p class="lead">
        Kilat Code menjalankan terminal <strong>Claude Code</strong> dan <strong>Codex</strong> yang asli di dalam satu aplikasi, dengan banyak akun yang bisa
        diganti tanpa login ulang. Halaman ini menjelaskan semuanya, dari instalasi sampai cara kerjanya.
      </p>
      <Content />
    </main>
  </div>
</Base>

<script>
  // Highlight the section being read in the table of contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']")];
  const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
  const visible = new Map<string, boolean>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => visible.set(e.target.id, e.isIntersecting));
      const first = [...byId.keys()].find((id) => visible.get(id));
      if (first) links.forEach((a) => a.classList.toggle("on", a === byId.get(first)));
    },
    { rootMargin: "-80px 0px -65% 0px" },
  );
  byId.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
</script>
