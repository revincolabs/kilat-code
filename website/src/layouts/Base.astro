---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME, SITE_URL } from "../site";
import { LANGS, OG_LOCALE, X_DEFAULT, localePath, other, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** page path without the language prefix: "/" or "/docs" */
  path: string;
  title: string;
  description: string;
  /** which nav link is the current page */
  current?: "home" | "docs";
  ogType?: "website" | "article";
  /** JSON-LD object for this page */
  jsonLd?: unknown;
  /** 404 and other pages that must stay out of the index */
  noindex?: boolean;
}

const { lang, path, title, description, current = "home", ogType = "website", jsonLd, noindex = false } = Astro.props;
const abs = (p: string) => new URL(p, SITE_URL).href;
const canonical = abs(localePath(lang, path));
const image = abs(`/og/kilat-${lang}.png`);
const t = ui[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {LANGS.map((l) => (
            <link rel="alternate" hreflang={l} href={abs(localePath(l, path))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={abs(localePath(X_DEFAULT, path))} />
        </>
      )
    }
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other(lang)]} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#isi">{t.skip}</a>
    <Header lang={lang} path={path} current={current} />
    <slot />
    <Footer lang={lang} />
    <script>
      // Mobile menu.
      const nav = document.querySelector<HTMLElement>(".site-header");
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      if (nav && toggle) {
        const labels = { open: toggle.dataset.open ?? "", close: toggle.dataset.close ?? "" };
        const set = (open: boolean) => {
          nav.classList.toggle("open", open);
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute("aria-label", open ? labels.close : labels.open);
        };
        toggle.addEventListener("click", () => set(!nav.classList.contains("open")));
        nav.querySelectorAll(".nav-links a").forEach((a) => a.addEventListener("click", () => set(false)));
        document.addEventListener("keydown", (e) => e.key === "Escape" && set(false));
      }
    </script>
  </body>
</html>
