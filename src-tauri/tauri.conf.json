{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kilat Code",
  "version": "0.2.0",
  "identifier": "dev.kilat.code",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kilat Code",
        "width": 1400,
        "height": 880,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0d0d0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "revincolabs",
    "copyright": "Copyright (c) 2026 revincolabs",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5M0JBMDU2RkEzRkMwRjUKUldUMXdELzZWcUE3ZWJSRUNwWXZNRndnVy9BK3lmQS83R25xNjRRL3d2bGZXWi9SZWRLWXFUNzIK",
      "endpoints": ["https://github.com/revincolabs/kilat-code/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
